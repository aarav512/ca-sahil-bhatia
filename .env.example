# Node
NODE_VERSION=20

# Google Drive — Document Library (folder must be “Anyone with the link can view”)
NEXT_PUBLIC_GOOGLE_DRIVE_FOLDER_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=

# Enquiry form + file upload (Google Apps Script or Cloud Function that saves to Drive)
NEXT_PUBLIC_ENQUIRY_WEBHOOK_URL=

# Tax updates JSON feed (array or { items: [] } of title, url, source, category, publishedAt, summary)
NEXT_PUBLIC_UPDATES_JSON_URL=
# Optional CORS proxy prefix if the JSON host does not allow the Pages origin
NEXT_PUBLIC_UPDATES_PROXY=
